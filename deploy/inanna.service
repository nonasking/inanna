# Inanna FastAPI 서버 — systemd 유닛 (launchd 대체).
# 설치: sudo cp deploy/inanna.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now inanna
# 재시작: sudo systemctl restart inanna     로그: journalctl -u inanna -f
[Unit]
Description=Inanna FastAPI server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inanna
WorkingDirectory=/home/inanna/inanna
# 데이터는 체크아웃 밖(/home/inanna/data)에 둬서 git pull 배포와 분리한다
EnvironmentFile=/home/inanna/inanna/.env
Environment=INANNA_DB=/home/inanna/data/inanna.db
Environment=INANNA_COMPANIONS_DIR=/home/inanna/data/companions
Environment=INANNA_VOICES_DIR=/home/inanna/data/voices
# Caddy가 앞단에서 TLS를 종단하므로 서버는 로컬호스트에만 바인딩한다 (외부 직접 노출 차단)
ExecStart=/home/inanna/inanna/.venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3
# 하드닝 — 앱은 자기 홈과 데이터 디렉토리 외에는 쓸 일이 없다
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/inanna/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
