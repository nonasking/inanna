# 서버 .env 템플릿 — /home/inanna/inanna/.env 로 복사 후 실제 값 채우기.
# 시크릿이므로 절대 git에 커밋하지 않는다 (.gitignore에 .env 등록됨).
# 편집 후: sudo systemctl restart inanna

# ── 필수 ──
INANNA_AUTH_TOKEN=          # 운영자(admin) 토큰 — 강한 랜덤값. `openssl rand -base64 32`
INANNA_PROVIDER=anthropic
ANTHROPIC_API_KEY=          # console.anthropic.com 키 (sk-ant-...)
INANNA_DEFAULT_TIER=beta
INANNA_INVITE_CODES=        # 초대 코드 쉼표구분 (부트스트랩 시드). 비면 초대제 비활성 주의

# ── 음성(선택) ── 베타는 edge TTS(무키)만 쓰므로 아래는 상위 티어용
INANNA_ELEVENLABS_API_KEY=  # sk_...

# ── 로컬 워커(이 서버에선 미사용, 비워둠) ──
# INANNA_SOVITS_URL / INANNA_OLLAMA_MODEL 등은 클라우드 서버에선 설정하지 않는다.
